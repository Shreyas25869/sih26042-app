# SIH 26042 — optional local/LAN model services
# Leave blank to use the built-in offline/browser fallbacks.
VITE_AI_TUTOR_API_URL=
VITE_TRANSLATOR_API_URL=

# These are stored locally from the Settings > model integration panel.
# The service contract expects POST JSON and a JSON response.
# AI Tutor response: { "answer": "..." }
# Translator response: { "translation": "..." }
# STT response: { "transcript": "..." }
# TTS response: model-specific JSON/audio payload
